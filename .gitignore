# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Large Datasets & Archives (> 100MB, exceeds GitHub limits)
archive.zip
*.zip
*.tar.gz
*.rar
raw/

# Model Checkpoints & Large Weights (> 100MB)
*.pth
*.pt
*.bin
*.h5
*.ckpt
*.npz

# Training outputs & temporary caches
catboost_info/
desktop.ini
*.log
*.tmp
.DS_Store

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
